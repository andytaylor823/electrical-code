# Azure OpenAI credentials (required)
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

# Web app password (shared with Adam for access gating)
NEC_APP_PASSWORD=pick-a-password

# Daily cost cap (USD) — the app stops accepting requests once this is exceeded
# Set to 0 to disable the limit
NEC_DAILY_COST_LIMIT=20
